[
  {"id":"user-caches","module":"system-junk","title":"Cache người dùng","group":"Cache","paths":["~/Library/Caches/*"],
   "exclude":["~/Library/Caches/com.apple.*","~/Library/Caches/CloudKit","~/Library/Caches/JetBrains","~/Library/Caches/Homebrew","~/Library/Caches/go-build","~/Library/Caches/pip","~/Library/Caches/Yarn","~/Library/Caches/CocoaPods","~/Library/Caches/composer","~/Library/Caches/Google","~/Library/Caches/BraveSoftware","~/Library/Caches/Microsoft Edge","~/Library/Caches/Firefox","~/Library/Caches/company.thebrowser.Browser","~/Library/Caches/com.openai.chat"],
   "appNotRunning":true,"safety":"safe"},
  {"id":"user-logs","module":"system-junk","title":"Log người dùng","group":"Log","paths":["~/Library/Logs/*"],
   "exclude":["~/Library/Logs/JetBrains","~/Library/Logs/DiagnosticReports"],"safety":"safe"},
  {"id":"crash-reports","module":"system-junk","title":"Báo cáo crash","group":"Log","paths":["~/Library/Logs/DiagnosticReports/*"],"minAgeDays":7,"safety":"safe"},
  {"id":"mail-downloads","module":"mail","title":"File đính kèm Mail đã tải","group":"Mail","paths":["~/Library/Containers/com.apple.mail/Data/Library/Mail Downloads/*"],"safety":"review","detail":"Cần Full Disk Access"},
  {"id":"mail-attachments","module":"mail","title":"Đính kèm Mail lưu cục bộ","group":"Mail","paths":["~/Library/Mail/V*/*/*.mbox/*/Data/{,*/,*/*/,*/*/*/}Attachments/*"],"quitBundle":"com.apple.mail","safety":"review","detail":"Tải lại được từ máy chủ (IMAP); thư POP3 hoặc \"Trên máy Mac\" sẽ mất vĩnh viễn. Cần Full Disk Access"},
  {"id":"mail-junk","module":"mail","title":"Thư rác trong Mail","group":"Mail","paths":["~/Library/Mail/V*/*/{Junk,Spam,Junk E-mail,Bulk Mail}.mbox/*/Data/*"],"quitBundle":"com.apple.mail","safety":"review","detail":"Chỉ xóa bản lưu trên máy này. Cần Full Disk Access"},
  {"id":"mail-trash","module":"mail","title":"Thư đã xóa trong Mail","group":"Mail","paths":["~/Library/Mail/V*/*/{Trash,Deleted Messages,Deleted Items,Bin}.mbox/*/Data/*"],"quitBundle":"com.apple.mail","safety":"review","detail":"Chỉ xóa bản lưu trên máy này. Cần Full Disk Access"},
  {"id":"photos-app-cache","module":"photos","title":"Cache ứng dụng Photos","group":"Photos","paths":["~/Library/Containers/com.apple.Photos/Data/Library/Caches/*","~/Library/Caches/com.apple.Photos*"],"quitBundle":"com.apple.Photos","safety":"review","detail":"Cần Full Disk Access"},
  {"id":"photos-analysis-cache","module":"photos","title":"Cache phân tích ảnh","group":"Photos","paths":["~/Library/Containers/com.apple.photoanalysisd/Data/Library/Caches/*","~/Library/Caches/com.apple.photoanalysisd/*"],"safety":"review","detail":"Cần Full Disk Access"},
  {"id":"photos-cache","module":"photos","title":"Cache Photos","group":"Photos","paths":["~/Library/Containers/com.apple.photolibraryd/Data/Library/Caches/*"],"safety":"review","detail":"Cần Full Disk Access"},

  {"id":"jetbrains-caches","module":"dev-junk","title":"Cache JetBrains IDE","group":"JetBrains","paths":["~/Library/Caches/JetBrains/*"],"skipIfRunningBundle":"com.jetbrains.*","safety":"safe"},
  {"id":"jetbrains-logs","module":"dev-junk","title":"Log JetBrains IDE","group":"JetBrains","paths":["~/Library/Logs/JetBrains/*"],"skipIfRunningBundle":"com.jetbrains.*","safety":"safe"},
  {"id":"npm-cache","module":"dev-junk","title":"Cache npm","group":"Node.js","paths":["~/.npm/_cacache"],"safety":"safe"},
  {"id":"yarn-cache","module":"dev-junk","title":"Cache Yarn","group":"Node.js","paths":["~/Library/Caches/Yarn"],"safety":"safe"},
