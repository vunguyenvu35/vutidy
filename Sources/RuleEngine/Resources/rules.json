  {"id":"edge-cache","module":"privacy","title":"Cache Edge","group":"Edge","paths":["~/Library/Caches/Microsoft Edge/*"],"quitBundle":"com.microsoft.edgemac","safety":"safe"},
  {"id":"arc-cache","module":"privacy","title":"Cache Arc","group":"Arc","paths":["~/Library/Caches/company.thebrowser.Browser"],"quitBundle":"company.thebrowser.Browser","safety":"safe"},
  {"id":"safari-cache","module":"privacy","title":"Cache Safari","group":"Safari","paths":["~/Library/Caches/com.apple.Safari"],"quitBundle":"com.apple.Safari","safety":"safe","detail":"Cần Full Disk Access"},
  {"id":"recent-items","module":"privacy","title":"Quick Look cache","group":"Hệ thống","paths":["~/Library/Caches/com.apple.QuickLook.thumbnailcache"],"safety":"safe"},
  {"id":"claude-desktop-cache","module":"dev-junk","title":"Cache Claude Desktop","group":"Claude","paths":["~/Library/Application Support/Claude/{Cache,Code Cache,GPUCache,DawnGraphiteCache,DawnWebGPUCache,GraphiteDawnCache,GPUPersistentCache,Shared Dictionary}"],"quitBundle":"com.anthropic.claudefordesktop","safety":"safe"},
  {"id":"claude-cowork-vm","module":"dev-junk","title":"Ổ ảo Cowork (Claude Desktop)","group":"Claude","paths":["~/Library/Application Support/Claude/vm_bundles/claudevm.bundle"],"quitBundle":"com.anthropic.claudefordesktop","safety":"review","detail":"Cowork sẽ tải và dựng lại ổ ảo (vài GB) khi dùng lần sau; sessiondata.img có thể chứa dữ liệu phiên Cowork"},
  {"id":"claude-code-temp","module":"dev-junk","title":"Cache Claude Code","group":"Claude","paths":["~/.claude/{cache,paste-cache,shell-snapshots,telemetry}/*"],"minAgeDays":7,"safety":"safe"},
  {"id":"claude-code-history","module":"dev-junk","title":"Lịch sử Claude Code cũ","group":"Claude","paths":["~/.claude/projects/*/*.jsonl"],"minAgeDays":90,"safety":"review","detail":"Hội thoại cũ hơn 90 ngày: xóa thì không /resume được các phiên đó; bộ nhớ dự án (memory) không bị đụng"},
  {"id":"claude-code-checkpoints","module":"dev-junk","title":"Điểm khôi phục file của Claude Code","group":"Claude","paths":["~/.claude/file-history/*"],"minAgeDays":30,"safety":"review","detail":"Bản sao file trước mỗi lần Claude Code sửa (để hoàn tác), cũ hơn 30 ngày"},
  {"id":"codex-desktop-cache","module":"dev-junk","title":"Cache Codex Desktop","group":"Codex","paths":["~/Library/Application Support/Codex/{Cache,Code Cache,GPUCache,DawnGraphiteCache,DawnWebGPUCache,GraphiteDawnCache,GPUPersistentCache,Shared Dictionary}"],"quitBundle":"com.openai.codex","safety":"safe"},
