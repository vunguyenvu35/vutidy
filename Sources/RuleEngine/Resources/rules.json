[
  {"id":"user-caches","module":"system-junk","title":"Cache người dùng","group":"Cache","paths":["~/Library/Caches/*"],
   "exclude":["~/Library/Caches/com.apple.*","~/Library/Caches/CloudKit","~/Library/Caches/JetBrains","~/Library/Caches/Homebrew","~/Library/Caches/go-build","~/Library/Caches/pip","~/Library/Caches/Yarn","~/Library/Caches/CocoaPods","~/Library/Caches/composer","~/Library/Caches/Google","~/Library/Caches/Firefox","~/Library/Caches/company.thebrowser.Browser"],
   "appNotRunning":true,"safety":"safe"},
  {"id":"user-logs","module":"system-junk","title":"Log người dùng","group":"Log","paths":["~/Library/Logs/*"],
   "exclude":["~/Library/Logs/JetBrains","~/Library/Logs/DiagnosticReports"],"safety":"safe"},
  {"id":"crash-reports","module":"system-junk","title":"Báo cáo crash","group":"Log","paths":["~/Library/Logs/DiagnosticReports/*"],"minAgeDays":7,"safety":"safe"},
  {"id":"mail-downloads","module":"system-junk","title":"File đính kèm Mail đã tải","group":"Mail","paths":["~/Library/Containers/com.apple.mail/Data/Library/Mail Downloads/*"],"safety":"review","detail":"Cần Full Disk Access"},
  {"id":"photos-cache","module":"system-junk","title":"Cache Photos","group":"Photos","paths":["~/Library/Containers/com.apple.photolibraryd/Data/Library/Caches/*"],"safety":"review","detail":"Cần Full Disk Access"},

  {"id":"jetbrains-caches","module":"dev-junk","title":"Cache JetBrains IDE","group":"JetBrains","paths":["~/Library/Caches/JetBrains/*"],"skipIfRunningBundle":"com.jetbrains.*","safety":"safe"},
  {"id":"jetbrains-logs","module":"dev-junk","title":"Log JetBrains IDE","group":"JetBrains","paths":["~/Library/Logs/JetBrains/*"],"skipIfRunningBundle":"com.jetbrains.*","safety":"safe"},
  {"id":"npm-cache","module":"dev-junk","title":"Cache npm","group":"Node.js","paths":["~/.npm/_cacache"],"safety":"safe"},
  {"id":"yarn-cache","module":"dev-junk","title":"Cache Yarn","group":"Node.js","paths":["~/Library/Caches/Yarn"],"safety":"safe"},
  {"id":"pnpm-store","module":"dev-junk","title":"Store pnpm","group":"Node.js","paths":["~/Library/pnpm/store"],"safety":"review","detail":"Cài lại sẽ phải tải lại package"},
  {"id":"go-build-cache","module":"dev-junk","title":"Go build cache","group":"Go","paths":["~/Library/Caches/go-build"],"requires":"go","command":["go","clean","-cache"],"safety":"safe"},
  {"id":"go-mod-cache","module":"dev-junk","title":"Go module cache","group":"Go","paths":["~/go/pkg/mod/cache"],"requires":"go","command":["go","clean","-modcache"],"safety":"review","detail":"Build offline sẽ không còn module"},
  {"id":"composer-cache","module":"dev-junk","title":"Cache Composer","group":"PHP","paths":["~/.composer/cache","~/Library/Caches/composer"],"safety":"safe"},
  {"id":"pip-cache","module":"dev-junk","title":"Cache pip","group":"Python","paths":["~/Library/Caches/pip"],"safety":"safe"},
  {"id":"xcode-derived","module":"dev-junk","title":"Xcode DerivedData","group":"Xcode","paths":["~/Library/Developer/Xcode/DerivedData/*"],"skipIfRunningBundle":"com.apple.dt.Xcode","safety":"safe"},
  {"id":"xcode-archives","module":"dev-junk","title":"Xcode Archives","group":"Xcode","paths":["~/Library/Developer/Xcode/Archives/*"],"safety":"review","detail":"Archive chứa dSYM dùng để symbolicate crash"},
  {"id":"xcode-devicesupport","module":"dev-junk","title":"iOS DeviceSupport","group":"Xcode","paths":["~/Library/Developer/Xcode/iOS DeviceSupport/*"],"safety":"review"},
  {"id":"xcode-sim-caches","module":"dev-junk","title":"CoreSimulator caches","group":"Xcode","paths":["~/Library/Developer/CoreSimulator/Caches/*"],"safety":"safe"},
  {"id":"homebrew-cache","module":"dev-junk","title":"Cache Homebrew","group":"Homebrew","paths":["~/Library/Caches/Homebrew"],"requires":"brew","command":["brew","cleanup","-s","--prune=all"],"safety":"safe"},
  {"id":"gradle-caches","module":"dev-junk","title":"Cache Gradle","group":"JVM","paths":["~/.gradle/caches"],"safety":"review","detail":"Build lần sau sẽ chậm hơn"},
  {"id":"cargo-registry","module":"dev-junk","title":"Cargo registry cache","group":"Rust","paths":["~/.cargo/registry/cache"],"safety":"review"},
  {"id":"cocoapods-cache","module":"dev-junk","title":"Cache CocoaPods","group":"CocoaPods","paths":["~/Library/Caches/CocoaPods"],"safety":"safe"},
  {"id":"ollama-models","module":"dev-junk","title":"Model Ollama","group":"LLM","paths":["~/.ollama/models"],"safety":"review","detail":"Chỉ liệt kê; xóa sẽ phải tải lại model"},
  {"id":"huggingface-hub","module":"dev-junk","title":"Model Hugging Face","group":"LLM","paths":["~/.cache/huggingface/hub/*"],"safety":"review"},

  {"id":"chrome-cache","module":"privacy","title":"Cache Chrome","group":"Chrome","paths":["~/Library/Caches/Google/Chrome/*"],"safety":"safe"},
  {"id":"firefox-cache","module":"privacy","title":"Cache Firefox","group":"Firefox","paths":["~/Library/Caches/Firefox/Profiles/*"],"safety":"safe"},
  {"id":"arc-cache","module":"privacy","title":"Cache Arc","group":"Arc","paths":["~/Library/Caches/company.thebrowser.Browser"],"safety":"safe"},
  {"id":"safari-cache","module":"privacy","title":"Cache Safari","group":"Safari","paths":["~/Library/Caches/com.apple.Safari"],"safety":"safe","detail":"Cần Full Disk Access"},
  {"id":"recent-items","module":"privacy","title":"Quick Look cache","group":"Hệ thống","paths":["~/Library/Caches/com.apple.QuickLook.thumbnailcache"],"safety":"safe"}
]
