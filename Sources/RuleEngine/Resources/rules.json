  {"id":"antigravity-cache","module":"dev-junk","title":"Cache Antigravity","group":"Antigravity","paths":["~/Library/Application Support/Antigravity/{Cache,CachedData,CachedExtensionVSIXs,Code Cache,GPUCache,DawnGraphiteCache,DawnWebGPUCache,GraphiteDawnCache,GPUPersistentCache,Shared Dictionary}"],"skipIfRunningBundle":"com.google.antigravity","safety":"safe"},
  {"id":"gemini-cli-temp","module":"dev-junk","title":"Cache Gemini CLI","group":"Gemini","paths":["~/.gemini/tmp/*"],"minAgeDays":7,"safety":"safe"},
